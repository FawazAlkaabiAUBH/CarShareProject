class PaymentGateway {
    +capture(amount, method, ref)
    +refund(ref)
}
class NotificationGateway {
    +deliver(message, method, recipient)
}
class MapProvider {
    +route(pickup, dropoff): List
    +eta(pickup, dropoff, time): double
}
class PricingPolicy {
    +price(route, time): double
}
class TaxPolicy {
    +tax(amount): double
}
class DiscountPolicy {
    +discount(userId, amount): double
}
