User <|-- Driver
User <|-- Rider
Driver "1" --> "0..*" Ride : posts >
Rider "1" --> "0..*" Booking : makes >
Ride "1" --> "0..*" Booking : contains >
Booking "1" --> "1" Payment : includes >
Ride "1" --> "0..*" Notification : triggers >
Rider "1" --> "0..*" Rating : gives >
Rating "1" --> "0..*" User : receives >
class AuthService {
    +authenticate(email, password)
    +validateCredentials(email, password)
    +recordLoginAttempt(userId)
    +verifyAccountStatus(userId)
}
class UserService {
    +updateName(userId, name)
    +updateEmail(userId, email)
    +updateLocation(userId, location)
    +deactivateAccount(userId)
    +getUserInfo(userId)
}
class RiderService {
    +initiateSeatBooking(riderId, rideId)
    +cancelSeatBooking(bookingId)
    +checkSeatAvailability(rideId)
    +confirmSeatReservation(bookingId)
    +updatePaymentMethod(riderId, method)
    +updatePreferredDriver(riderId, driverId)
    +updatePickupLocation(riderId, location)
    +submitDriverRating(riderId, driverId, rideId, score, comment)
}
class DriverService {
    +createRideListing(driverId, details)
    +updateRideDetails(rideId, details)
    +cancelRideListing(rideId)
    +updateVehicleDetails(driverId, vehicleInfo)
    +updateAvailabilityStatus(driverId, status)
    +updateDriverLicense(driverId, licenseNumber)
}
class RideService {
    +initiateRideSession(rideId)
    +updateStatus(rideId, status)
    +cancelRide(rideId, reason)
    +completeRide(rideId)
    +trackRideLocation(rideId, location)
    +updateLocation(rideId, location)
    +storeRouteData(rideId, route)
}
class FareService {
    +computeFare(rideId): double
    +estimateFare(pickup, dropoff, time): double
    +applyTaxesAndDiscounts(amount): double
}
class RoutingService {
    +getETA(pickup, dropoff, time): double
    +generateRoute(pickup, dropoff): List
}
class BookingService {
    +createBooking(riderId, rideId)
    +cancelBooking(bookingId, reason)
    +modifyBookingStatus(bookingId, status)
    +finalizeBooking(bookingId)
    +assignDriver(bookingId, driverId)
    +reassignDriver(bookingId, driverId)
    +linkRideDetails(bookingId, rideId)
    +notifyParties(bookingId)
}
class PaymentService {
    +processPayment(bookingId, method)
    +updatePaymentStatus(paymentId, status)
    +calculateFinalAmount(paymentId): double
    +refund(paymentId)
    +verifyPayment(paymentId)
    +confirmTransaction(paymentId)
    +generateReceipt(paymentId)
}
class RatingService {
    +submitRating(riderId, driverId, rideId, score, comment)
    +updateRating(ratingId, score, comment)
    +deleteRating(ratingId)
    +validateRatingScore(score)
    +computeDriverAverage(driverId): double
    +computeRiderAverage(riderId): double
}
class NotificationService {
    +sendNotification(userId, message, method)
    +scheduleNotification(userId, message, method, time)
    +updateStatus(notificationId, status)
    +cancelScheduledNotification(notificationId)
    +loadNotificationTemplate(type): String
    +generateMessage(type, context): String
    +personalizeContent(userId, template): String
}
class UserRepository {
    +findById(userId: int): User
    +findByEmail(email: String): User
    +findByRole(role: String): List~User~
    +search(nameOrEmail: String): List~User~
    +save(user: User): void
    +delete(userId: int): void
    +exists(userId: int): Boolean
    +updateLastLogin(userId: int, at: DateTime): void
    +updateStatus(userId: int, status: String): void
}
class RiderRepository {
    +findById(riderId: int): Rider
    +findByUserId(userId: int): Rider
